      "text": "Pure function retryPayment integrates with existing server route handlers without modifying payment state management or health endpoint behavior.",
      "verification": "UNVERIFIED"
    },
    {
      "field": "correctness",
      "evidenceIds": [
        "criterion-retry-transient",

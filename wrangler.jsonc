{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "judge-c2c",
  "preview_urls": true,
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health", "/webhooks/*"],
  },
  "observability": {
    "enabled": true,
  },
  "vars": {
    "ENVIRONMENT": "review",
    "DEMO_MODE": "true",
    "PREVIEW_TESTING": "true",
  },
  "previews": {
    "vars": {
      "ENVIRONMENT": "review",
      "DEMO_MODE": "true",
      "PREVIEW_TESTING": "true",
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "judge-c2c-review",
        "database_id": "cbbc7d68-2fef-40c6-be53-511ffb0d720c",
        "migrations_dir": "migrations",
      },
    ],
    "workflows": [
      {
        "binding": "PREVIEW_EVALUATOR",
        "name": "judge-c2c-public-preview-evaluator",
        "class_name": "PublicPreviewWorkflow",
        "script_name": "judge-c2c-review",
      },
    ],
  },
  "env": {
    "local": {
      "name": "judge-c2c-local",
      "vars": {
        "ENVIRONMENT": "local",
        "DEMO_MODE": "true",
        "PREVIEW_TESTING": "true",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "judge-c2c-local",
          "database_id": "local-only",
          "migrations_dir": "migrations",
        },
      ],
      "workflows": [
        {
          "binding": "EVALUATOR",
          "name": "judge-c2c-local-evaluator",
          "class_name": "EvaluationWorkflow",
        },
        {
          "binding": "PREVIEW_EVALUATOR",
          "name": "judge-c2c-local-preview-evaluator",
          "class_name": "PublicPreviewWorkflow",
        },
      ],
    },
    "review": {
      "name": "judge-c2c-review",
      "vars": {
        "ENVIRONMENT": "review",
        "DEMO_MODE": "true",
        "PREVIEW_TESTING": "true",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "judge-c2c-review",
          "database_id": "cbbc7d68-2fef-40c6-be53-511ffb0d720c",
          "migrations_dir": "migrations",
        },
      ],
      "workflows": [
        {
          "binding": "EVALUATOR",
          "name": "judge-c2c-review-evaluator",
          "class_name": "EvaluationWorkflow",
        },
        {
          "binding": "PREVIEW_EVALUATOR",
          "name": "judge-c2c-public-preview-evaluator",
          "class_name": "PublicPreviewWorkflow",
        },
      ],
      "workers_dev": false,
      "preview_urls": false,
      "triggers": {
        "crons": ["*/2 * * * *"],
      },
    },
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "judge-c2c-review",
      "database_id": "cbbc7d68-2fef-40c6-be53-511ffb0d720c",
      "migrations_dir": "migrations",
    },
  ],
  "workflows": [
    {
      "binding": "PREVIEW_EVALUATOR",
      "name": "judge-c2c-public-preview-evaluator",
      "class_name": "PublicPreviewWorkflow",
      "script_name": "judge-c2c-review",
    },
  ],
}
